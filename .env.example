# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paddle Configuration
# Get API key from: https://vendors.paddle.com/authentication (or sandbox.paddle.com)
PADDLE_API_KEY=your-api-key-here
# Webhook secret set when creating webhook in Paddle dashboard
PADDLE_WEBHOOK_SECRET=your-webhook-secret-here
# "sandbox" for testing, "production" for live
PADDLE_ENVIRONMENT=sandbox
# Seller ID (shown in Paddle dashboard → Developer → Authentication)
PADDLE_SELLER_ID=12345

# Paddle Price IDs (create products & prices in Paddle dashboard)
PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxxxx
PADDLE_PRO_YEARLY_PRICE_ID=pri_xxxxx
PADDLE_BUSINESS_MONTHLY_PRICE_ID=pri_xxxxx
PADDLE_BUSINESS_YEARLY_PRICE_ID=pri_xxxxx

# Optional: Deno Deploy Configuration
# DENO_DEPLOY_TOKEN=your-deploy-token
